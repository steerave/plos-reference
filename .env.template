# PLOS — local environment template.
# Copy to .env and fill in. .env is gitignored.
#
# Phase 1 populates the variables below. Phase 2+ adds vault path,
# SMTP for digest, Claude session config.

# --- Phase 1: Paperless-ngx (consumed by docker-compose) ------------------
# Admin user created on first container start. Change before first run.
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=changeme
PAPERLESS_SECRET_KEY=changeme-generate-a-random-50-char-string

# Host port Paperless is published on. Container always listens on 8000
# internally; this controls the host side of the port mapping. Override
# if 8000 is already in use on your machine. Keep PAPERLESS_URL_PUBLIC
# below in sync.
PAPERLESS_HOST_PORT=8000

# --- Phase 1: PLOS sidecar SQLite + worker --------------------------------
# Absolute host path to the PLOS sidecar database. The same file is mounted
# into the Paperless container so the post-consume hook (in-container) and
# the worker (on the host) write to the same SQLite file.
PLOS_DB_PATH=G:\plos-data\plos\plos.db

# Worker poll interval, seconds. Default 60.
PLOS_WORKER_POLL_SECONDS=60

# Public Paperless URL — used to construct paperless_url stored in SQLite.
# Must match PAPERLESS_HOST_PORT above (or your reverse-proxy URL).
PAPERLESS_URL_PUBLIC=http://localhost:8000
# --- Phase 2: Paperless API client + vault writer ------------------------
# API token used by the worker to fetch OCR'd document text from Paperless.
# Generate one via the Paperless UI: My Profile (top-right avatar) -> 'Show'
# next to API Auth Token, or click to regenerate. Paste the value here.
PAPERLESS_API_TOKEN=
# Vault root the worker writes into. Defaults to examples/sample-vault
# (the fictional household used by the public reference repo). Point at
# your real vault when running the operating instance.
PLOS_VAULT_ROOT=examples/sample-vault
